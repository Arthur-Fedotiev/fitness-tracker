{
  "name": "exercise-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/exercise/domain/src",
  "prefix": "exercise",
  "tags": ["domain:exercise", "type:domain-logic"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/exercise/domain"],
      "options": {
        "jestConfig": "libs/exercise/domain/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "libs/exercise/domain/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/exercise/domain/**/*.ts", "libs/exercise/domain/**/*.html"]
      }
    }
  }
}
