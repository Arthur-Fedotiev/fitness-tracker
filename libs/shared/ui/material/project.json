{
  "name": "shared-ui-material",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/shared/ui/material/src",
  "selector": "ft",
  "tags": ["domain:shared", "type:ui"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/shared/ui/material"],
      "options": {
        "jestConfig": "libs/shared/ui/material/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "libs/shared/ui/material/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/shared/ui/material/src/**/*.ts", "libs/shared/ui/material/src/**/*.html"]
      }
    }
  }
}
