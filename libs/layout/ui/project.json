{
  "name": "layout-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/layout/ui/src",
  "selector": "ft",
  "tags": ["domain:layout", "type:ui"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/layout/ui"],
      "options": {
        "jestConfig": "libs/layout/ui/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "libs/layout/ui/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/layout/ui/src/**/*.ts", "libs/layout/ui/src/**/*.html"]
      }
    }
  }
}
