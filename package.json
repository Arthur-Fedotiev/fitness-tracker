{
  "name": "fitness-tracker",
  "version": "0.0.0",
  "license": "MIT",
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "nx serve",
    "build": "nx build --stats-json",
    "test": "nx test",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "lint:all": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "local-function": "firebase emulators:start --only functions",
    "local-dev": "firebase emulators:start --only firestore,functions --import sample-exercises",
    "empty-emulator": "firebase-emulators:start",
    "export-emulator": "firebase emulators:export sample-exercises",
    "emulator": "firebase emulators:start --only=firestore,functions,auth --import=emulated-samples --export-on-exit",
    "analyze:fitness-tracker": "webpack-bundle-analyzer dist/apps/fitness-tracker/stats.json",
    "serve:prod": "nx build && firebase serve --only hosting -p 3000",
    "cypress:run": "cd apps/fitness-tracker-e2e/ && cypress run",
    "cypress:open": "cd apps/fitness-tracker-e2e/ && cypress open",
    "deploy:staging": "firebase use staging && nx run fitness-tracker:build:staging && firebase deploy --only hosting",
    "deploy:prod": "firebase use prod && nx run fitness-tracker:build:production && firebase deploy --only hosting",
    "deploy-functions:staging": "firebase use staging && firebase deploy --only functions",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "format:staged": "nx format:write --uncommitted",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ddd": "21.0.0",
    "@angular/animations": "21.2.9",
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/fire": "21.0.0-rc.0",
    "@angular/forms": "21.2.9",
    "@angular/material": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/pwa": "21.2.9",
    "@angular/router": "21.2.9",
    "@angular/service-worker": "21.2.9",
    "@ng-web-apis/common": "^4.0.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngrx/effects": "21.1.1",
    "@ngrx/entity": "21.1.1",
    "@ngrx/signals": "21.1.1",
    "@ngrx/store": "21.1.1",
    "@nx/angular": "22.7.8",
    "firebase": "^12.17.1",
    "lodash-es": "^4.17.21",
    "rxjs": "7.8.1",
    "shared-package": "file:shared-package-5.7.0.tgz",
    "tslib": "^2.7.0",
    "write-excel-file": "^4.1.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.9",
    "@angular-devkit/core": "21.2.9",
    "@angular-devkit/schematics": "21.2.9",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "21.2.9",
    "@angular/language-service": "21.2.9",
    "@hirez_io/observer-spy": "^2.2.0",
    "@ngrx/schematics": "21.1.1",
    "@ngrx/store-devtools": "21.1.1",
    "@nx/cypress": "22.7.8",
    "@nx/eslint": "22.7.8",
    "@nx/eslint-plugin": "22.7.8",
    "@nx/jest": "22.7.8",
    "@nx/js": "22.7.8",
    "@nx/workspace": "22.7.8",
    "@schematics/angular": "21.2.9",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "cypress": "^13.15.0",
    "cypress-firebase": "^2.2.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-cypress": "^3.5.0",
    "firebase-admin": "^12.6.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "16.0.0",
    "nx": "22.7.8",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "5.9.3",
    "webpack-bundle-analyzer": "^4.10.0"
  }
}
